###  https://test.org/webreasoning2025#followEntry
:followEntry rdf:type owl:NamedIndividual ,
                      ontolex:LexicalEntry ;
             ontolex:canonicalForm :followLemma ;
             ontolex:otherForm :followedForm ,
                               :followingForm ,
                               :followsForm .


###  https://test.org/webreasoning2025#followLemma
:followLemma rdf:type owl:NamedIndividual ,
                      ontolex:Form ;
             ontolex:phoneticRep "fɒloʊ"@en-fonipa ;
             ontolex:writtenRep "follow"@en .


###  https://test.org/webreasoning2025#followedForm
:followedForm rdf:type owl:NamedIndividual ,
                       ontolex:Form .


###  https://test.org/webreasoning2025#followingForm
:followingForm rdf:type owl:NamedIndividual ,
                        ontolex:Form .


###  https://test.org/webreasoning2025#followsForm
:followsForm rdf:type owl:NamedIndividual ,
                      ontolex:Form .


